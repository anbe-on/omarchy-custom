#!/bin/bash
#
# Display Hyprland keybindings (via walker for an interactive search menu).
#
# WHY THIS READS THE LUA SOURCE INSTEAD OF `hyprctl -j binds`:
# For binds registered via hl.bind() using a raw keycode (e.g. "SUPER +
# code:18") or a multi-line Lua-function callback, Hyprland's own bind
# table reports NO usable key info at all:
#
#   "key": "", "keycode": 0, "dispatcher": "__lua", "arg": "95"
#
# `arg` there is an internal Lua closure id, not the key. There is
# nothing to parse or reverse-engineer - the physical key just isn't in
# hyprctl's output for these binds. The only place it still exists in
# plain text is the Lua source itself, so that's what we read.
#
# WHERE TO FIND WHICH LUA FILES ARE ACTUALLY LOADED
#
# Rather than hardcoding a file list (which drifts the moment you add,
# remove, or swap a bindings file), this greps your Hyprland Lua config
# for the actual `dofile(...)` calls and resolves them itself - so it
# always tracks whatever is really loaded.
#
# Handles the common Omarchy pattern:
#   local omarchy = os.getenv("HOME") .. "/.local/share/omarchy"
#   dofile(omarchy .. "/default/hypr/bindings/media.lua")
# as well as plain `dofile("/absolute/path.lua")` calls.
#
# Override the search root if your config lives somewhere unusual:
#   HYPR_CONFIG_DIR=/path/to/hypr omarchy-menu-keybindings --print
HYPR_CONFIG_DIR="${HYPR_CONFIG_DIR:-$HOME/.config/hypr}"

discover_binding_files() {
  local dir="$HYPR_CONFIG_DIR"
  [[ -d "$dir" ]] || return 1

  local -a lua_files=()
  mapfile -t lua_files < <(find "$dir" -name '*.lua' 2>/dev/null)
  [[ ${#lua_files[@]} -eq 0 ]] && return 1

  # Pass 1: collect `var = os.getenv("HOME") .. "suffix"` base-path variables
  local -A base_map=()
  local line
  while IFS= read -r line; do
    if [[ "$line" =~ ([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=[[:space:]]*os\.getenv\(\"HOME\"\)[[:space:]]*\.\.[[:space:]]*\"([^\"]*)\" ]]; then
      base_map["${BASH_REMATCH[1]}"]="${BASH_REMATCH[2]}"
    fi
  done < <(cat "${lua_files[@]}" 2>/dev/null)

  # Pass 2: resolve dofile(var .. "relpath") using that map, or plain
  # dofile("literal/path") calls directly
  local -a found=()
  local var suffix
  while IFS= read -r line; do
    if [[ "$line" =~ dofile\([[:space:]]*([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*\.\.[[:space:]]*\"([^\"]*)\"[[:space:]]*\) ]]; then
      var="${BASH_REMATCH[1]}"
      suffix="${BASH_REMATCH[2]}"
      [[ -n "${base_map[$var]:-}" ]] && found+=("$HOME${base_map[$var]}$suffix")
    elif [[ "$line" =~ dofile\([[:space:]]*\"([^\"]+)\"[[:space:]]*\) ]]; then
      found+=("${BASH_REMATCH[1]}")
    fi
  done < <(cat "${lua_files[@]}" 2>/dev/null)

  [[ ${#found[@]} -eq 0 ]] && return 1
  printf '%s\n' "${found[@]}"
}

mapfile -t BINDING_FILES < <(discover_binding_files)
if [[ ${#BINDING_FILES[@]} -eq 0 ]]; then
  echo "warning: couldn't auto-discover dofile()'d bindings under $HYPR_CONFIG_DIR; falling back to Omarchy defaults" >&2
  BINDING_FILES=(
    "$HOME/.local/share/omarchy/default/hypr/bindings/media.lua"
    "$HOME/.local/share/omarchy/default/hypr/bindings/tiling.lua"
    "$HOME/.local/share/omarchy/default/hypr/bindings/utilities.lua"
  )
fi

set -uo pipefail
FS=$'\x1f'   # unit separator: not IFS-whitespace, so `read` never collapses empty fields

# --- Lookup tables (display only - for prettifying key tokens) -------------

declare -A XF86_MAP=(
  [XF86AudioRaiseVolume]="Volume up"
  [XF86AudioLowerVolume]="Volume down"
  [XF86AudioMute]="Mute"
  [XF86AudioMicMute]="Mute microphone"
  [XF86AudioNext]="Next track"
  [XF86AudioPause]="Pause"
  [XF86AudioPlay]="Play"
  [XF86AudioPrev]="Previous track"
  [XF86AudioStop]="Stop"
  [XF86AudioRecord]="Record"
  [XF86MonBrightnessUp]="Brightness up"
  [XF86MonBrightnessDown]="Brightness down"
  [XF86KbdBrightnessUp]="Keyboard brightness up"
  [XF86KbdBrightnessDown]="Keyboard brightness down"
  [XF86KbdLightOnOff]="Keyboard backlight"
  [XF86PowerOff]="Power menu"
  [XF86Calculator]="Calculator"
  [XF86WWW]="Browser"
  [XF86Mail]="Mail"
  [XF86ScreenSaver]="Screen saver"
  [XF86Sleep]="Sleep"
  [XF86Wakeup]="Wake"
  [XF86Eject]="Eject"
  [XF86Suspend]="Suspend"
  [XF86Battery]="Battery"
  [XF86WWAN]="WWAN"
  [XF86RFKill]="Radio kill"
  [XF86Documents]="Documents"
  [XF86Pictures]="Pictures"
  [XF86Music]="Music"
  [XF86Video]="Video"
  [XF86Camera]="Camera"
  [XF86MusicPlayer]="Music player"
  [XF86HomePage]="Home page"
)

# code:N seen in the provided configs - top number/punctuation row,
# standard US layout. Add more here if you bind other raw keycodes.
declare -A KEYCODE_MAP=(
  [10]="1" [11]="2" [12]="3" [13]="4" [14]="5"
  [15]="6" [16]="7" [17]="8" [18]="9" [19]="0"
  [20]="-" [21]="="
)

# --- Parse Lua source into "raw_key_combo<FS>description" lines ------------
#
# Small state machine over each file: when a line contains hl.bind("..."),
# remember the key combo. Keep scanning (same line or later ones, to cover
# multi-line function-callback binds like ALT+TAB) until a
# description = "..." is found, then emit the pair and reset.

parse_lua_binds() {
  local file
  for file in "${BINDING_FILES[@]}"; do
    [[ -f "$file" ]] || { echo "warning: $file not found, skipping" >&2; continue; }
    gawk -v fs="$FS" '
      match($0, /hl\.bind\([ \t]*"([^"]*)"/, m) { pending_key = m[1]; have_key = 1 }
      match($0, /description[ \t]*=[ \t]*"([^"]*)"/, m2) {
        if (have_key) {
          print pending_key fs m2[1]
          have_key = 0
        }
      }
    ' "$file"
  done
}

# Hardcoded binds not registered through hl.bind(), like the copy-url extension.
static_bindings() {
  printf 'SHIFT + ALT + L%sCopy URL from Web App\n' "$FS"
}

# --- Key-token prettifying ---------------------------------------------------

resolve_token() {
  local tok="$1"

  if [[ "$tok" == code:* ]]; then
    local code="${tok#code:}"
    printf '%s' "${KEYCODE_MAP[$code]:-keycode $code}"
    return
  fi

  if [[ "$tok" == mouse:* ]]; then
    case "${tok#mouse:}" in
      272) printf 'LEFT MOUSE BUTTON' ;;
      273) printf 'RIGHT MOUSE BUTTON' ;;
      274) printf 'MIDDLE MOUSE BUTTON' ;;
      *)   printf '%s' "$tok" ;;
    esac
    return
  fi

  if [[ "$tok" == XF86* ]]; then
    printf '%s' "${XF86_MAP[$tok]:-$tok}"
    return
  fi

  case "$tok" in
    SUPER|SHIFT|CTRL|ALT) printf '%s' "$tok"; return ;;
  esac

  # Generic fallback for anything else (mouse_down, mouse_up, Slash, etc.)
  printf '%s' "${tok//_/ }"
}

prettify_combo() {
  local combo="$1" IFS='+' tok out=()
  read -ra parts <<<"$combo"
  for tok in "${parts[@]}"; do
    tok="${tok#"${tok%%[![:space:]]*}"}"   # trim leading space
    tok="${tok%"${tok##*[![:space:]]}"}"   # trim trailing space
    [[ -z "$tok" ]] && continue
    out+=("$(resolve_token "$tok")")
  done
  local IFS=' '
  printf '%s' "${out[*]}"
}

# --- Build the final list ---------------------------------------------------

build_entries() {
  local combo description
  while IFS="$FS" read -r combo description; do
    [[ -z "$combo" || -z "$description" ]] && continue
    printf '%-35s → %s\n' "$(prettify_combo "$combo")" "$description"
  done < <({ parse_lua_binds; static_bindings; } | sort -u)
}

# --- Ordering ---------------------------------------------------------------
# Roughly mirrors the priority you had before, matched against the
# description text (which is now always meaningful, since it's
# hand-written at the bind site rather than inferred).

prioritize_entries() {
  awk '
  {
    line = $0
    prio = 50
    if (line ~ /Terminal/)                      prio = 0
    if (line ~ /Tmux/)                          prio = 1
    if (line ~ /Browser/)                       prio = 2
    if (line ~ /File manager/)                  prio = 3
    if (line ~ /Launch apps/)                   prio = 4
    if (line ~ /Omarchy menu/)                  prio = 5
    if (line ~ /System menu/)                   prio = 6
    if (line ~ /Theme/)                         prio = 7
    if (line ~ /Full screen/)                   prio = 8
    if (line ~ /Full width/)                    prio = 9
    if (line ~ /Close window/)                  prio = 10
    if (line ~ /Close all windows/)             prio = 11
    if (line ~ /Lock system/)                   prio = 12
    if (line ~ /Toggle window floating/)        prio = 13
    if (line ~ /Toggle window split/)           prio = 14
    if (line ~ /Pop window/)                    prio = 15
    if (line ~ /Universal/)                     prio = 16
    if (line ~ /Clipboard/)                     prio = 17
    if (line ~ /Audio controls/)                prio = 18
    if (line ~ /Bluetooth controls/)            prio = 19
    if (line ~ /Wifi controls/)                 prio = 20
    if (line ~ /Emoji picker/)                  prio = 21
    if (line ~ /Color picker/)                  prio = 22
    if (line ~ /Screenshot/)                    prio = 23
    if (line ~ /Screenrecording/)               prio = 24
    if (line ~ /Move window focus|Move focus/)  prio = 31
    if (line ~ /Switch to workspace/)           prio = 27
    if (line ~ /Move window to workspace/)      prio = 28
    if (line ~ /Move window silently/)          prio = 29
    if (line ~ /Swap window/)                   prio = 30
    if (line ~ /Resize window|Expand window|Shrink window/) prio = 33
    if (line ~ /scratchpad/)                    prio = 36
    if (line ~ /notification/)                  prio = 37
    if (line ~ /Toggle window transparency/)    prio = 38
    if (line ~ /Toggle window gaps/)            prio = 39
    if (line ~ /nightlight/)                    prio = 40
    if (line ~ /locking/)                       prio = 41
    if (line ~ /group/)                         prio = 94
    if (line ~ /Scroll active workspace/)       prio = 95
    if (line ~ /Cycle to/)                      prio = 96
    if (line ~ /Apple Display/)                 prio = 98
    printf "%d\t%s\n", prio, line
  }' | sort -k1,1n -k2,2 | cut -f2-
}

# --- Entry point -------------------------------------------------------------

if [[ "${1:-}" == "--print" || "${1:-}" == "-p" ]]; then
  build_entries | prioritize_entries
else
  monitor_height=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true) | .height')
  menu_height=$(( monitor_height * 30 / 100 ))
  build_entries | prioritize_entries |
    walker --dmenu -p 'Keybindings' --width 800 --height "$menu_height"
fi
