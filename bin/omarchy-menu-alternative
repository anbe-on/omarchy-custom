OPTIONS=""
for key in "${!MENU_MAP[@]}"; do
  OPTIONS+="$key\n"
done

SELECTION=$(echo -e -n "$OPTIONS" | omarchy-launch-walker --dmenu --width 400 --minheight 1 --maxheight 630 -p "Search Menu…" 2>/dev/null)

if [[ -n "$SELECTION" && -n "${MENU_MAP[$SELECTION]}" ]]; then
  eval "${MENU_MAP[$SELECTION]}"
fi
