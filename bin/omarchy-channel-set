#!/bin/bash

# Pin the Omarchy package repository. Only two coherent choices remain:
#
#   stable - Omarchy stable package repo + stable Arch mirror. This is the
#            supported configuration; rc/edge/dev are not offered because this
#            fork has diverged from upstream and the edge mirror is not used.
#   arch   - Omarchy stable package repo + live Arch mirrors chosen with
#            reflector (see omarchy-mirror-switch).
#
# The [omarchy] repo stays enabled in both modes; see omarchy-pkg-origin for
# which packages that repo actually serves AUR code for.

if (($# == 0)); then
  echo "Usage: omarchy-channel-set [stable|arch]"
  exit 1
else
  channel="$1"
fi

case "$channel" in
"stable")
  sudo cp -f "$OMARCHY_PATH/default/pacman/pacman-stable.conf" /etc/pacman.conf
  sudo cp -f "$OMARCHY_PATH/default/pacman/mirrorlist-stable" /etc/pacman.d/mirrorlist
  echo "Pinned to Omarchy stable repo + stable Arch mirror"
  ;;
"arch")
  sudo cp -f "$OMARCHY_PATH/default/pacman/pacman-stable.conf" /etc/pacman.conf
  echo "Pinned to Omarchy stable repo; choosing Arch mirrors with reflector..."
  omarchy-mirror-switch
  ;;
*)
  echo "Unknown channel: $channel (expected: stable or arch)"
  exit 1
  ;;
esac

omarchy-update -y
