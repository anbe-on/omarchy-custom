#!/bin/bash

# Launch the Omarchy screensaver in the default terminal on the system with the correct font configuration.

# Exit early if we don't have the tte show
if ! command -v tte &>/dev/null; then
  exit 1
fi

# Exit early if screensave is already running
pgrep -f org.omarchy.screensaver && exit 0

# Allow screensaver to be turned off but also force started
if [[ -f ~/.local/state/omarchy/toggles/screensaver-off ]] && [[ $1 != "force" ]]; then
  exit 1
fi

# Silently quit Walker on overlay
walker -q

focused=$(hyprctl monitors -j | jq -r '.[] | select(.focused == true).name')
terminal=$(xdg-terminal-exec --print-id)

# `hyprctl dispatch focusmonitor <name>` and `hyprctl dispatch exec -- ...`
# stopped working under Hyprland's Lua config ("keyword/legacy dispatch
# can't work with non-legacy parsers"). Replaced with the Lua-native
# equivalents below, called through `hyprctl dispatch`.

hypr_focus_monitor() {
  hyprctl dispatch "hl.dsp.focus({ monitor = \"$1\" })" >/dev/null 2>&1
}

hypr_exec() {
  local command="$1"
  # [[ ]] is a Lua long-bracket string, so we don't have to escape any
  # quotes that show up inside the command itself.
  hyprctl dispatch "hl.dsp.exec_cmd([[$command]])" >/dev/null 2>&1
}

for m in $(hyprctl monitors -j | jq -r '.[] | .name'); do
  hypr_focus_monitor "$m"

  case $terminal in
  *Alacritty*)
    hypr_exec "alacritty --class=org.omarchy.screensaver \
      --config-file ~/.local/share/omarchy/default/alacritty/screensaver.toml \
      -e omarchy-cmd-screensaver"
    ;;
  *ghostty*)
    hypr_exec "ghostty --class=org.omarchy.screensaver \
      --config-file=~/.local/share/omarchy/default/ghostty/screensaver \
      --font-size=18 \
      -e omarchy-cmd-screensaver"
    ;;
  *kitty*)
    hypr_exec "kitty --class=org.omarchy.screensaver \
      --override font_size=18 \
      --override window_padding_width=0 \
      -e omarchy-cmd-screensaver"
    ;;
  *)
    notify-send "✋  Screensaver only runs in Alacritty, Ghostty, or Kitty"
    ;;
  esac
done

hypr_focus_monitor "$focused"
