{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "none",
        "position": "top",
        "padding": {
            "bottom": 0,
            "top": 0,
            "right": 1
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        {
            "key": "╭───────────╮",
            "type": "custom"
        },
        {
            "type": "title",
            "key": "│ {#30}{#39} u@h     {#keys}│",
            "format": "{user-name}@{host-name}"
        },
        {
            "key": "│ {#33}󰍛{#39} cpu     {#keys}│",
            "type": "cpu",
            "temp": true,
            "showPeCoreCount": true
        },
        {
          "type": "gpu",
          "key": "| {#33}{icon}{#39} gpu     {#keys}│",
          "detectionMethod": "auto",
          "driverSpecific": true,
          "format": "{name} {#2}C:{core-count}{?frequency} {frequency}{?} {type}"
        },
        {
          "key": "│ {#33}{#39} ram     {#keys}│",
          "type": "memory"
        },
        {
          "key": "│ {#33}{#39} swap    {#keys}│",
          "type": "swap"
        },
        {
            "type": "disk",
            "key": "│ {#33}󰉉{#39} disk    {#keys}│",
            "format": "{mountpoint} – {size-used} \/ {size-total} ({size-percentage})"
        },
        {
            "key": "│ {#33}󰩟{#39} network {#keys}│",
            "type": "localip",
            "format": "({ifname})"
        },
        {
            "key": "│ {#33}󰩟{#39} battery {#keys}│",
            "type": "battery"
        },
        {
            "key": "│ {#30}{icon}{#39} distro  {#keys}│{#30}",
            "type": "os"
        },
        {
            "key": "│ {#30}{#39} kernel  {#keys}│",
            "type": "kernel"
        },
        {
            "key": "│ {#37}󰇄{#39} desktop {#keys}│",
            "type": "de"
        },
        {
            "key": "│ {#37}{icon}{#39} wm      {#keys}│",
            "type": "wm"
        },
        {
            "type": "command",
            "keyIcon": "",
            "key": "│ {#37}{icon}{#39} wm      {#keys}│",
            "text": "glazewm --version",
            "format": "glazewm {~7}"
        },
        {
            "type": "display",
            "key": "│ {#37}{icon}{#39} display {#keys}│",
            "format": "{width}x{height} @ {refresh-rate} Hz {physical-width}x{physical-height} mm ({inch} inches, {ppi} ppi)"
        },
        {
            "key": "│ {#cyan}{#39} term    {#keys}│",
            "type": "terminal"
        },
        {
            "key": "│ {#cyan}{#39} shell   {#keys}│",
            "type": "shell"
        },
        {
            "key": "│ {#cyan}{#39} pkg     {#keys}│",
            "type": "packages"
        },
        {
            "type": "command",
            "keyIcon": "",
            "key": "│ {#cyan}{icon}{#39} Rust    {#keys}│",
            "text": "rustc --version | cut -d' ' -f2",
            "format": "rustc {}"
        },
        {
            "type": "command",
            "keyIcon": "",
            "key": "│ {#cyan}{icon}{#39} Clang   {#keys}│",
            "text": "clang --version | head -1 | awk '{print $NF}'",
            "format": "clang {}"
        },
        {
            "type": "command",
            "keyIcon": "",
            "key": "│ {#cyan}{icon}{#39} NodeJS  {#keys}│",
            "text": "node --version",
            "format": "node {~1}"
        },
        {
            "type": "command",
            "keyIcon": "",
            "key": "│ {#cyan}{icon}{#39} python  {#keys}│",
            "text": "python --version",
            "format": "python {~7}"
        },
        {
            "type": "command",
            "keyIcon": "",
            "key": "│ {#cyan}{icon}{#39} Go      {#keys}│",
            "text": "go version | cut -d' ' -f3",
            "format": "go {~2}"
        },
        {
            "type": "command",
            "keyIcon": "",
            "key": "│ {#cyan}{icon}{#39} Zig     {#keys}│",
            "text": "zig version",
            "format": "zig {}"
        },
        {
            "type": "editor",
            "key": "│ {#cyan}{icon}{#39} Editor  {#keys}│"
        },
        {
            "type": "command",
            "keyIcon": "󰊢",
            "key": "│ {#cyan}{icon}{#39} Git     {#keys}│",
            "text": "git version",
            "format": "git {~12}"
        },
        {
          "key": "│ {#34}󰅐{#39} uptime  {#keys}│",
          "type": "uptime"
        },
        {
          "type": "disk",
          "keyIcon": "",
          "key": "│ {#34}{icon}{#39} os age  {#keys}│",
          "folders": "/",
          "format": "{create-time:10} {#2}[{days} days]"
        },
        {
            "key": "├───────────┤",
            "type": "custom"
        },
        {
            "key": "│ {#39} colors  {#keys}│",
            "type": "colors",
            "symbol": "circle"
        },
        {
            "key": "╰───────────╯",
            "type": "custom"
        }
    ]
}
